 },
 {
  "n": 116,
  "a": {
   "id": 13420622,
   "lang": "fin",
   "text": "Hän ei tiedä nimeäni."
  },
  "c": {
   "id": 6883892,
   "lang": "vol",
   "text": "No noloms nemi obik."
  }
 },
 {
  "n": 117,
  "a": {
   "id": 1212369,
   "lang": "tur",
   "text": "İş hayatının çoğunluğunu bir diplomat olarak geçirdi."
