 },
 {
  "n": 137,
  "a": {
   "id": 13744385,
   "lang": "rus",
   "text": "Мы думаем о своих проблемах."
  },
  "c": {
   "id": 11177601,
   "lang": "kab",
   "text": "Nettmeyyiz i yiɣeblan-nneɣ."
  }
 },
 {
