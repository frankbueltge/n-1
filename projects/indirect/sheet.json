   "text": "Bɣiɣ imdanen ay izemren ad mahlen."
  },
  "c": {
   "id": 11246554,
   "lang": "vol",
   "text": "Nedob menis kanölis vobön."
  }
 },
 {
  "n": 122,
  "a": {
   "id": 3684730,
   "lang": "swe",
   "text": "Jag gör det, fast på ett villkor."
  },
  "c": {
   "id": 11841076,
   "lang": "por",
   "text": "Eu vou, mas com uma condição."
  }
 },
 {
  "n": 123,
  "a": {
   "id": 372884,
   "lang": "deu",
   "text": "Sie ist was man einen Fachidioten nennt."
  },
  "c": {
   "id": 310515,
   "lang": "eng",
   "text": "She is what is called a learned fool."
  }
 },
 {
  "n": 124,
