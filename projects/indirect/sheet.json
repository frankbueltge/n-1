 },
 {
  "n": 118,
  "a": {
   "id": 897429,
   "lang": "pol",
   "text": "Poznałem go w zeszłym roku."
  },
  "c": {
   "id": 6654,
   "lang": "fra",
   "text": "J'ai fait sa connaissance l'année dernière."
  }
 },
 {
  "n": 119,
  "a": {
   "id": 4210892,
   "lang": "tur",
   "text": "Biz gerçekten büyük bir kavga ettik."
  },
  "c": {
   "id": 3333619,
   "lang": "fin",
   "text": "Meillä oli tosi iso tappelu."
  }
 },
 {
  "n": 120,
  "a": {
   "id": 10451166,
   "lang": "eng",
   "text": "I want to go and see the cherry trees in blossom."
  },
  "c": {
   "id": 11234672,
   "lang": "fra",
   "text": "Je veux aller voir les cerisiers en fleurs."
  }
 },
 {
  "n": 121,
  "a": {
   "id": 8548724,
