  "c": {
   "id": 1473627,
   "lang": "nld",
   "text": "De geur van lelies vulde de kamer."
  }
 },
 {
  "n": 115,
  "a": {
   "id": 417287,
   "lang": "rus",
   "text": "Если не опоздаешь на поезд, ты успеешь туда вовремя."
