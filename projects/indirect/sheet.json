 },
 {
  "n": 92,
  "a": {
   "id": 11727738,
   "lang": "nld",
   "text": "Vandaag beschouw ik mezelf als de gelukkigste man ter aarde."
  },
  "c": {
   "id": 10651087,
   "lang": "fra",
   "text": "Aujourd'hui, je me considère comme l'homme le plus chanceux du monde."
  }
 },
 {
  "n": 93,
