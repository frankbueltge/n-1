 },
 {
  "n": 89,
  "a": {
   "id": 8226104,
   "lang": "ces",
   "text": "Chováš se arogantně."
  },
  "c": {
   "id": 8226107,
   "lang": "eng",
   "text": "You are being arrogant."
  }
 },
 {
  "n": 90,
  "a": {
   "id": 2271252,
   "lang": "mar",
   "text": "विंडोजची पुढची आवृत्ती या महीन्याच्या शेवटागोदर येईल हे मला असंभवनीय वाटतं."
  },
  "c": {
   "id": 1525500,
   "lang": "jpn",
   "text": "今月中にウインドウズの次のバージョンが出る見込みはないと思う。"
  }
 },
 {
  "n": 91,
  "a": {
   "id": 3199779,
   "lang": "jpn",
   "text": "「お前まさかもう酔ってる？」「酔ってない酔ってない」"
  },
  "c": {
   "id": 3219103,
   "lang": "rus",
   "text": "\"Только не говори мне, что ты уже пьяный!\" - \"Нет-нет\"."
